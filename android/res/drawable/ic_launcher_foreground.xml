    <path
        android:pathData="M29,42 L45,58 M45,42 L29,58"
        android:strokeColor="#FF2E86FF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <!-- yellow O -->
    <path
        android:pathData="M71,39 A11,11 0 1,1 70.99,39 Z"
        android:strokeColor="#FFFFD23F"
        android:strokeWidth="6.5" />
    <!-- underline in both colours -->
    <path
        android:pathData="M30,70 L52,70"
        android:strokeColor="#FF2E86FF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M56,70 L78,70"
        android:strokeColor="#FFFFD23F"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
