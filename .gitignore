# build output (dist/TicTacToe.apk is kept on purpose)
build/
*.idsig

# Play Store upload file - rebuilt by build-apk.ps1
dist/*.aab

# signing key + its password - keep a private backup, never commit them
*.keystore
*.jks
keystore.properties

# online server: local test databases (node server/local.mjs <port> <file>)
*.sqlite

# downloaded build tools (bundletool)
tools/bin/

# local tooling
.claude/
